{
  "name": "persimmon",
  "version": "0.0.0",
  "private": true,
  "description": "Workflow engine for AI-native software delivery",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "bin": {
    "persimmon": "dist/main.js"
  },
  "scripts": {
    "build": "tsc && npm run build:tools",
    "build:tools": "vite build --config tools/eventstorming/vite.config.ts",
    "dev:tools": "vite --config tools/eventstorming/vite.config.ts",
    "gen": "node scripts/gen-schemas.mjs",
    "prebuild": "npm run gen",
    "prepare": "npm run build",
    "pretest": "npm run gen",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && npm run typecheck:tools",
    "typecheck:tools": "tsc -p tools/eventstorming --noEmit"
  },
  "dependencies": {
    "@google/design.md": "0.4.0",
    "@marcbachmann/cel-js": "8.0.0",
    "@xmldom/xmldom": "0.9.12",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.2",
    "@types/node": "26.6.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@xyflow/react": "12.11.2",
    "lucide-react": "1.24.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwindcss": "4.3.2",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "5.0.1",
    "zustand": "5.0.14"
  },
  "files": [
    "dist",
    "adapters",
    "tools/eventstorming/grammar",
    "packs",
    "README.md",
    "LICENSE"
  ]
}
