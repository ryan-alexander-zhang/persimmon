{
  "name": "persimmon",
  "version": "0.0.0",
  "private": true,
  "description": "Workflow engine for AI-native software delivery",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "bin": {
    "persimmon": "dist/main.js"
  },
  "scripts": {
